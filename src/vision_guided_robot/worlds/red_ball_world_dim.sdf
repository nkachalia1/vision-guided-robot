<?xml version="1.0"?>
<sdf version="1.9">
  <world name="red_ball_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <light name="dim_key_light" type="directional">
      <pose>-2 -3 6 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.22 0.22 0.20 1</diffuse>
      <specular>0.03 0.03 0.03 1</specular>
      <direction>0.4 0.6 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <box>
              <size>20 20 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <box>
              <size>20 20 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.19 0.18 1</ambient>
            <diffuse>0.22 0.24 0.23 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://vision_bot</uri>
      <name>vision_bot</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
