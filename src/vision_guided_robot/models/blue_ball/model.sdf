<?xml version="1.0"?>
<sdf version="1.9">
  <model name="blue_ball">
    <static>true</static>
    <link name="ball_link">
      <collision name="ball_collision">
        <geometry>
          <sphere>
            <radius>0.10</radius>
          </sphere>
        </geometry>
      </collision>
      <visual name="ball_visual">
        <geometry>
          <sphere>
            <radius>0.10</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0 0.08 1 1</ambient>
          <diffuse>0 0.10 1 1</diffuse>
          <specular>0.05 0.05 0.3 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
